{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "portable-eval case",
  "type": "object",
  "required": ["id", "spec_id", "type", "criteria", "severity", "risk_family", "source", "input", "expected", "split", "added_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "spec_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["regression", "capability", "safety"]},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "severity": {"enum": ["critical", "high", "normal", "low"]},
    "pair_id": {"type": ["string", "null"]},
    "risk_family": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["incident", "trace", "synthetic"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "input": {"type": "object"},
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "state"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "state"}, "state": {"type": "object"}}
        },
        {
          "type": "object",
          "required": ["kind", "rubric_id"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "rubric"}, "rubric_id": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "known_bad_ref": {"type": "string", "minLength": 1},
    "known_bad_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "known_good_ref": {"type": "string", "minLength": 1},
    "known_good_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split": {"enum": ["dev", "regression", "blind"]},
    "added_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"}
  },
  "allOf": [
    {
      "if": {"required": ["type"], "properties": {"type": {"const": "regression"}}},
      "then": {"required": ["known_bad_ref", "known_bad_sha256"]}
    },
    {
      "if": {"required": ["known_bad_ref"]},
      "then": {"required": ["known_bad_sha256"]}
    },
    {
      "if": {"required": ["known_good_ref"]},
      "then": {"required": ["known_good_sha256"]}
    }
  ]
}
